{
  "name": "qualix",
  "description": "Android 自动化测试平台，提供测试编排、双模式 AI 编排和 Midscene 原版 Playground。",
  "version": "2.0.9",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oooooooko/Qualix.git"
  },
  "bugs": {
    "url": "https://github.com/oooooooko/Qualix/issues"
  },
  "homepage": "https://github.com/oooooooko/Qualix#readme",
  "type": "module",
  "bin": {
    "qualix": "bin/qualix.js"
  },
  "files": [
    "assets",
    "bin",
    "index.html",
    "remote-agent",
    "server",
    "ai-flow",
    "ai-task",
    "src",
    "locales",
    "tsconfig*.json",
    "vite.config.ts",
    "README.md",
    "*.en.md",
    "USAGE.md",
    "流程节点操作说明.md",
    "AI识别操作说明.md",
    "FAQ.md",
    "CHANGELOG.md",
    "!**/test/**",
    "!**/tests/**",
    "!**/e2e/**",
    "!**/__tests__/**",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/test_*.py",
    "!**/conftest.py",
    "!**/playwright.config.*",
    "!**/vitest.config.*",
    "!**/jest.config.*",
    "!**/tsconfig.spec.json",
    "!**/.env",
    "!**/.env.*",
    "!**/.npmrc",
    "!**/.npmrc.*",
    "!**/config.json",
    "!**/config.json.*",
    "!**/config.yaml",
    "!**/config.yaml.*",
    "!**/config.yml",
    "!**/config.yml.*",
    "!**/chats.yaml",
    "!**/chats.yaml.*",
    "!**/chats.yml",
    "!**/chats.yml.*",
    "!**/credentials.json",
    "!**/credentials.json.*",
    "!**/secrets.json",
    "!**/secrets.json.*",
    "!**/.midscene-app/**",
    "!**/.midscene-generated/**",
    "!**/midscene_run/**",
    "!**/scripts-output/**",
    "!**/traces/**",
    "!**/.tmp/**",
    "!**/tmp/**",
    "!**/.cache/**",
    "!**/*.sqlite",
    "!**/*.sqlite-*",
    "!**/*.sqlite3",
    "!**/*.sqlite3-*",
    "!**/*.db",
    "!**/*.db-*",
    "!**/*.pem",
    "!**/*.key",
    "!**/*.p12",
    "!**/*.pfx",
    "!**/*.keystore",
    "!**/*.jks",
    "!**/*.log"
  ],
  "scripts": {
    "dev": "node bin/start-dev.mjs",
    "prepack": "node bin/sync-readme-docs.mjs",
    "remote-agent": "tsx remote-agent/index.ts",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "pw:install": "playwright install chromium",
    "test:e2e": "playwright test",
    "test:compat": "node --test tests/legacy-cli.test.mjs",
    "test:ai-flow": "tsx --test ai-flow/server/*.test.ts",
    "test:ai-flow:ui": "playwright test --config ai-flow/playwright.config.ts",
    "test:ai-task": "tsx --test ai-task/server/*.test.ts"
  },
  "dependencies": {
    "@yume-chan/adb": "2.6.3",
    "@yume-chan/adb-scrcpy": "2.3.2",
    "@yume-chan/adb-server-node-tcp": "2.5.2",
    "@yume-chan/scrcpy": "2.3.0",
    "mediabunny": "1.58.0",
    "@dagrejs/dagre": "1.1.5",
    "@element-plus/icons-vue": "2.3.2",
    "@techstark/opencv-js": "5.0.0-release.1",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue-flow/core": "1.48.2",
    "archiver": "7.0.1",
    "element-plus": "2.11.1",
    "openai": "5.23.2",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vue": "3.5.39",
    "word-extractor": "1.0.4",
    "xlsx": "0.18.5",
    "yaml": "2.9.0",
    "sharp": "0.34.5",
    "@midscene/android": "https://registry.npmjs.org/@midscene/android/-/android-1.17.5.tgz",
    "@midscene/core": "https://registry.npmjs.org/@midscene/core/-/core-1.17.5.tgz",
    "@midscene/shared": "https://registry.npmjs.org/@midscene/shared/-/shared-1.17.5.tgz",
    "@midscene/web": "https://registry.npmjs.org/@midscene/web/-/web-1.17.5.tgz",
    "@midscene/android-playground": "https://registry.npmjs.org/@midscene/android-playground/-/android-playground-1.17.5.tgz",
    "@midscene/playground": "https://registry.npmjs.org/@midscene/playground/-/playground-1.17.5.tgz"
  },
  "overrides": {
    "@floating-ui/core": "1.7.5",
    "@floating-ui/dom": "1.7.6",
    "nanoid": "3.3.15",
    "playwright": "1.61.1",
    "playwright-core": "1.61.1",
    "postcss": "8.5.16",
    "rollup": "4.62.2",
    "@midscene/android": "https://registry.npmjs.org/@midscene/android/-/android-1.17.5.tgz",
    "@midscene/core": "https://registry.npmjs.org/@midscene/core/-/core-1.17.5.tgz",
    "@midscene/shared": "https://registry.npmjs.org/@midscene/shared/-/shared-1.17.5.tgz",
    "@midscene/web": "https://registry.npmjs.org/@midscene/web/-/web-1.17.5.tgz",
    "@midscene/android-playground": "https://registry.npmjs.org/@midscene/android-playground/-/android-playground-1.17.5.tgz",
    "@midscene/playground": "https://registry.npmjs.org/@midscene/playground/-/playground-1.17.5.tgz"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.2",
    "@types/pngjs": "6.0.5",
    "@types/word-extractor": "1.0.6",
    "@vue/tsconfig": "0.7.0",
    "vue-tsc": "3.3.6",
    "yauzl": "3.2.0"
  }
}
